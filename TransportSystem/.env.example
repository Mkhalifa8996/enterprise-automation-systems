# إعدادات البرنامج — انسخ هذا الملف إلى .env واملأ القيم المطلوبة
# لا ترفع ملف .env إلى Git — هو ضمن .gitignore
#
# ملاحظة: عند تشغيل البرنامج لأول مرة سيظهر نافذة لإدخال بيانات Firebase
# وتُحفظ تلقائياً في firebase_sync_config.json (وهو أيضاً غير مرفوع إلى Git).
# كل القيم أدناه اختيارية، ويمكن تركها فارغة إن لم تكن تحتاج المزامنة السحابية.

# ---------- بيانات الشركة (ترويسة الفواتير والكشوف المطبوعة) ----------

# الاسم بالعربية والإنجليزية
# TRANSPORT_COMPANY_NAME_AR=اسم شركتك
# TRANSPORT_COMPANY_NAME_EN=YOUR COMPANY NAME

# العنوان
# TRANSPORT_COMPANY_ADDRESS_AR=
# TRANSPORT_COMPANY_ADDRESS_EN=

# الهاتف والبريد الإلكتروني
# TRANSPORT_COMPANY_PHONE=
# TRANSPORT_COMPANY_EMAIL=

# ---------- Firebase (اختياري: للمزامنة السحابية) ----------

# مفتاح API من إعدادات مشروع Firebase
# FIREBASE_API_KEY=

# البريد الإلكتروني لتسجيل الدخول إلى Firebase
# FIREBASE_EMAIL=

# كلمة المرور لتسجيل الدخول إلى Firebase
# FIREBASE_PASSWORD=

# رابط قاعدة بيانات Firebase (اتركه فارغاً إن لم تستخدم المزامنة)
# FIREBASE_DATABASE_URL=

# رمز التحديث للمزامنة مع Firebase (اختياري)
# FIREBASE_REFRESH_TOKEN=

# ---------- أخرى ----------

# كلمة مرور المدير للبرنامج (اختياري - إذا لم يتم تعيينها سيتم إنشاء واحدة عشوائية)
# TRANSPORT_ADMIN_PASSWORD=

# مسار قاعدة البيانات (اختياري - مفيد لعزل الاختبارات)
# TRANSPORT_DB_PATH=